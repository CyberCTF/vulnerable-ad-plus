{
  "$schema": "https://www.isoloom.com/schema/run-manifest/v0.json",
  "manifest_version": 0,
  "generator": {
    "name": "isoloom",
    "version": "1.0.2"
  },
  "environment": {
    "name": "vulnerable-ad-plus",
    "instance": null,
    "message": "vulnerable-AD-plus is up: dc01, the domain controller of change.me, at 10.60.85.10.\nUsers and paths are random on every build. Start anonymously (LDAP, SMB), find a first\naccount, then chain ACLs to Domain Admin.\nDomain Admin reads the flag in C:\\ctf\\flag.txt on dc01.\n"
  },
  "target": "proxmox",
  "driver": "terraform",
  "hosts": [
    "linux",
    "macos",
    "windows"
  ],
  "tools": [
    {
      "name": "terraform",
      "probe": [
        "terraform",
        "version"
      ],
      "min_version": "1.6.0",
      "container": "hashicorp/terraform:1.9.8@sha256:18f9986038bbaf02cf49db9c09261c778161c51dcc7fb7e355ae8938459428cd",
      "container_hosts": [
        "macos"
      ]
    },
    {
      "name": "ssh",
      "probe": [
        "ssh",
        "-V"
      ]
    }
  ],
  "identity": {
    "terraform": {
      "module": ".",
      "state": "runner"
    }
  },
  "params": [
    {
      "name": "proxmox_endpoint",
      "description": "https://<server>:8006/.",
      "required": true,
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "proxmox_endpoint"
        }
      ]
    },
    {
      "name": "proxmox_username",
      "description": "The module's `proxmox_username`.",
      "default": "root@pam",
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "proxmox_username"
        }
      ]
    },
    {
      "name": "proxmox_insecure",
      "description": "Accept the server's self-signed certificate.",
      "default": "true",
      "values": [
        "true",
        "false"
      ],
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "proxmox_insecure"
        }
      ]
    },
    {
      "name": "proxmox_ssh_username",
      "description": "Uploading cloud-init snippets goes over SSH to the node.",
      "default": "root",
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "proxmox_ssh_username"
        }
      ]
    },
    {
      "name": "proxmox_ssh_address",
      "description": "The node's SSH address, when the API reports one this machine can't reach.",
      "default": "",
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "proxmox_ssh_address"
        }
      ]
    },
    {
      "name": "node",
      "description": "The Proxmox node the VMs go on (`pvesh get /nodes` lists them).",
      "required": true,
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "node"
        }
      ]
    },
    {
      "name": "datastore",
      "description": "Where VM disks go.",
      "default": "local-lvm",
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "datastore"
        }
      ]
    },
    {
      "name": "image_datastore",
      "description": "A datastore with 'iso' content, for cloud images.",
      "default": "local",
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "image_datastore"
        }
      ]
    },
    {
      "name": "snippets_datastore",
      "description": "A datastore with 'snippets' content, for cloud-init.",
      "default": "local",
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "snippets_datastore"
        }
      ]
    },
    {
      "name": "uplink_bridge",
      "description": "The bridge the router reaches the internet through.",
      "default": "vmbr0",
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "uplink_bridge"
        }
      ]
    },
    {
      "name": "template_windows_server_2019",
      "description": "The VM id of a `windows-server-2019` template: cloudbase-init and the VirtIO drivers installed, UEFI on Q35, its disk on virtio0, sysprepped.",
      "required": true,
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "template_windows_server_2019"
        }
      ]
    },
    {
      "name": "ISOLOOM_DERIVED",
      "description": "0: the checks derived from the spec (reachability, no internet) are skipped.",
      "default": "1",
      "values": [
        "0",
        "1"
      ],
      "set_by": "embedder",
      "deliver": [
        {
          "via": "env",
          "var": "ISOLOOM_DERIVED",
          "steps": [
            "check-networks"
          ]
        }
      ]
    }
  ],
  "secrets": [
    {
      "name": "proxmox_api_token",
      "kind": "connection",
      "required": false,
      "sensitive": true,
      "deliver": [
        {
          "via": "tf_var",
          "var": "proxmox_api_token"
        }
      ]
    },
    {
      "name": "proxmox_password",
      "kind": "connection",
      "required": false,
      "sensitive": true,
      "deliver": [
        {
          "via": "tf_var",
          "var": "proxmox_password"
        }
      ]
    }
  ],
  "networks": [
    {
      "name": "lab",
      "cidr": "10.60.85.0/24",
      "internet": true,
      "native": "i${run.slot}n0"
    }
  ],
  "machines": [
    {
      "name": "dc01",
      "role": "target",
      "os": "windows-server-2019",
      "windows": true,
      "arch": "amd64",
      "addresses": {
        "lab": "10.60.85.10"
      },
      "ports": [
        {
          "name": "dns",
          "port": 53,
          "protocol": "tcp",
          "http": false
        },
        {
          "name": "kerberos",
          "port": 88,
          "protocol": "tcp",
          "http": false
        },
        {
          "name": "rpc",
          "port": 135,
          "protocol": "tcp",
          "http": false
        },
        {
          "name": "ldap",
          "port": 389,
          "protocol": "tcp",
          "http": false
        },
        {
          "name": "smb",
          "port": 445,
          "protocol": "tcp",
          "http": false
        },
        {
          "name": "winrm",
          "port": 5985,
          "protocol": "tcp",
          "http": false
        }
      ]
    },
    {
      "name": "isoloom-router",
      "role": "infra",
      "addresses": {
        "lab": "10.60.85.254"
      }
    },
    {
      "name": "isoloom-controller",
      "role": "infra",
      "addresses": {
        "lab": "10.60.85.253"
      }
    }
  ],
  "lifecycle": {
    "up": [
      {
        "id": "clear-lock",
        "action": "terraform.clear_lock"
      },
      {
        "id": "init",
        "note": "Preparing Terraform and its providers…",
        "argv": [
          "terraform",
          "init",
          "-input=false",
          "-no-color",
          "-backend-config=path=${run.state_dir}/terraform.tfstate"
        ],
        "env": {
          "TF_DATA_DIR": "${run.state_dir}/.terraform",
          "TF_INPUT": "0",
          "TF_IN_AUTOMATION": "1",
          "TF_VAR_proxmox_ssh_private_key_file": "${run.ssh_key}",
          "TF_VAR_slot": "${run.slot}",
          "TF_VAR_ssh_public_key": "${run.ssh_public_key}"
        },
        "timeout_s": 600
      },
      {
        "id": "apply",
        "note": "Creating the lab's VMs on the server…",
        "argv": [
          "terraform",
          "apply",
          "-auto-approve",
          "-input=false",
          "-no-color"
        ],
        "env": {
          "TF_DATA_DIR": "${run.state_dir}/.terraform",
          "TF_INPUT": "0",
          "TF_IN_AUTOMATION": "1",
          "TF_VAR_proxmox_ssh_private_key_file": "${run.ssh_key}",
          "TF_VAR_slot": "${run.slot}",
          "TF_VAR_ssh_public_key": "${run.ssh_public_key}"
        },
        "timeout_s": 3600
      }
    ],
    "down": [
      {
        "id": "clear-lock",
        "action": "terraform.clear_lock"
      },
      {
        "id": "init",
        "note": "Preparing Terraform and its providers…",
        "argv": [
          "terraform",
          "init",
          "-input=false",
          "-no-color",
          "-backend-config=path=${run.state_dir}/terraform.tfstate"
        ],
        "env": {
          "TF_DATA_DIR": "${run.state_dir}/.terraform",
          "TF_INPUT": "0",
          "TF_IN_AUTOMATION": "1",
          "TF_VAR_proxmox_ssh_private_key_file": "${run.ssh_key}",
          "TF_VAR_slot": "${run.slot}",
          "TF_VAR_ssh_public_key": "${run.ssh_public_key}"
        },
        "timeout_s": 600
      },
      {
        "id": "destroy",
        "note": "Removing the lab from the server…",
        "argv": [
          "terraform",
          "destroy",
          "-auto-approve",
          "-input=false",
          "-no-color",
          "-refresh=false"
        ],
        "env": {
          "TF_DATA_DIR": "${run.state_dir}/.terraform",
          "TF_INPUT": "0",
          "TF_IN_AUTOMATION": "1",
          "TF_VAR_proxmox_ssh_private_key_file": "${run.ssh_key}",
          "TF_VAR_slot": "${run.slot}",
          "TF_VAR_ssh_public_key": "${run.ssh_public_key}"
        },
        "timeout_s": 1800
      }
    ],
    "status": {
      "id": "state",
      "action": "terraform.read_state"
    }
  },
  "ready": [
    {
      "kind": "step_ok",
      "step": "apply",
      "means": "the VMs exist and booted; each sets itself up from its cloud-init"
    },
    {
      "kind": "ready_file",
      "host": "10.60.85.253",
      "user": "isoloom",
      "path": "${outputs.ready_file}",
      "log": "/var/log/cloud-init-output.log",
      "grammar": "isoloom-ready/1",
      "via": "isoloom@${outputs.ip}",
      "timeout_s": 7200,
      "unreachable_timeout_s": 600,
      "interval_s": 10
    }
  ],
  "outputs": [
    {
      "name": "ip",
      "description": "The router's uplink address: the published ports answer there, and SSH reaches the machines through it.",
      "role": "address",
      "sensitive": false,
      "from": {
        "kind": "terraform_output",
        "name": "ip"
      }
    },
    {
      "name": "ssh_user",
      "description": "The user every Linux VM and the router let in with the runner's key.",
      "role": "info",
      "sensitive": false,
      "from": {
        "kind": "terraform_output",
        "name": "ssh_user"
      }
    },
    {
      "name": "ready_file",
      "description": "Where each Linux machine's set-up says how far it got (isoloom-ready/1).",
      "role": "info",
      "sensitive": false,
      "from": {
        "kind": "terraform_output",
        "name": "ready_file"
      }
    }
  ],
  "checks": {
    "protocol": "isoloom-check/1",
    "setup": [],
    "runners": [
      {
        "id": "networks",
        "from": "from controller",
        "checks": [
          {
            "name": "dns answers",
            "kind": "tcp",
            "wait_s": 300,
            "derived": false
          },
          {
            "name": "kerberos answers",
            "kind": "tcp",
            "wait_s": 30,
            "derived": false
          },
          {
            "name": "ldap answers",
            "kind": "tcp",
            "wait_s": 30,
            "derived": false
          },
          {
            "name": "smb answers",
            "kind": "tcp",
            "wait_s": 30,
            "derived": false
          },
          {
            "name": "winrm answers",
            "kind": "tcp",
            "wait_s": 30,
            "derived": false
          },
          {
            "name": "checks/vulnerable-ad-plus.sh",
            "kind": "script",
            "wait_s": 0,
            "derived": false
          },
          {
            "name": "dc01:53 from the networks",
            "kind": "tcp",
            "wait_s": 30,
            "derived": true
          },
          {
            "name": "dc01:88 from the networks",
            "kind": "tcp",
            "wait_s": 30,
            "derived": true
          },
          {
            "name": "dc01:135 from the networks",
            "kind": "tcp",
            "wait_s": 30,
            "derived": true
          },
          {
            "name": "dc01:389 from the networks",
            "kind": "tcp",
            "wait_s": 30,
            "derived": true
          },
          {
            "name": "dc01:445 from the networks",
            "kind": "tcp",
            "wait_s": 30,
            "derived": true
          },
          {
            "name": "dc01:5985 from the networks",
            "kind": "tcp",
            "wait_s": 30,
            "derived": true
          }
        ],
        "step": {
          "id": "check-networks",
          "action": "ssh.run",
          "with": {
            "command": "ISOLOOM_DERIVED=${params.ISOLOOM_DERIVED} sh -s",
            "host": "10.60.85.253",
            "user": "isoloom",
            "via": "isoloom@${outputs.ip}"
          },
          "stdin": "checks/networks.sh",
          "timeout_s": 840
        }
      }
    ],
    "teardown": []
  }
}
